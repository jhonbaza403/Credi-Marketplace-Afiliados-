# ==========================================================
# Credi Marketplace
# Public environment template
#
# Node.js 24.x + Next.js 16.3.x + React 19 + Supabase
#
# This file contains placeholders only. Never add real secrets.
# ==========================================================

# ==========================================================
# SUPABASE - PUBLIC
# ==========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# ==========================================================
# APPLICATION - PUBLIC
# ==========================================================
NEXT_PUBLIC_APP_URL=https://credi-marketplace-afiliados.vercel.app
NEXT_PUBLIC_APP_NAME=Credi Marketplace
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_COUNTRY=VE
NEXT_PUBLIC_ENV=development

# ==========================================================
# SUPABASE - SERVER ONLY
# ==========================================================
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ==========================================================
# OPENAI - SERVER ONLY
# ==========================================================
# Never expose this value with NEXT_PUBLIC_ and never commit a real key.
OPENAI_API_KEY=
# Premium model routing:
# gpt-5.6-sol is used for strategy/marketing/intelligence.
# gpt-5.6-luna is used for copilot/sales.
OPENAI_MODEL=
OPENAI_ENABLE_WEB_SEARCH=false
# The application keeps response continuity in a user-owned Credi AI session.
AI_MAX_INPUT_LENGTH=8000
AI_MAX_OUTPUT_TOKENS=1800
AI_REQUEST_TIMEOUT_MS=30000
AI_REQUESTS_PER_MINUTE=20

# ==========================================================
# GOOGLE GEMINI - SERVER ONLY
# ==========================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRODUCT_MODEL=
AI_MODEL=

# ==========================================================
# BILLING / SUBSCRIPTIONS - SERVER ONLY
# ==========================================================
# Stripe Billing + hosted Checkout.
# Create the webhook endpoint at:
# https://YOUR-DOMAIN/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================================
# COINBASE BUSINESS CHECKOUTS - SERVER ONLY
# ==========================================================
# Create an ECDSA CDP API key in Coinbase Business.
# Store the private EC key with escaped newlines (\\n) when using Vercel env vars.
COINBASE_BUSINESS_API_KEY_NAME=
COINBASE_BUSINESS_API_KEY_SECRET=
# Webhook secret returned when creating the Checkout webhook subscription.
COINBASE_BUSINESS_WEBHOOK_SECRET=

# Optional integration/configuration controls
PAYMENT_PROVIDER=stripe
CRYPTO_PAYMENT_PROVIDER=
PLATFORM_COMMISSION_RATE=
RATE_LIMIT_ENABLED=true
CREDI_BANK_ROUTING=
CREDI_BANK_SWIFT=

# ==========================================================
# B2B STABLECOIN PAYMENTS - SERVER ONLY
# ==========================================================
# Enable only after provider onboarding and jurisdiction review.
B2B_CRYPTO_ENABLED=false
B2B_CRYPTO_MERCHANT_COUNTRY=US

# ==========================================================
# CREDI BUSINESS CHAT - EPHEMERAL TURN (SERVER ONLY)
# ==========================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ==========================================================
# GOVERNED CREDI AI AGENT - SERVER ONLY
# ==========================================================
# Dedicated secret for expiring HMAC approvals. Falls back to
# Supabase server secret only when this variable is absent.
AGENT_APPROVAL_SECRET=
# Maximum amount a governed agent can prepare as a payment intent.
CREDI_AGENT_MAX_PAYMENT_AMOUNT=1000

# ==========================================================
# VERCEL / BUILD CONTEXT
# ==========================================================
# Vercel injects these during builds. They are informational only.
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_PREVIOUS_SHA=

# ==========================================================
# CLOUDFLARE STREAM - SERVER ONLY
# ==========================================================
# Required only for Credi LIVE RTMP/HLS transport management.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ==========================================================
# PLAYWRIGHT - LOCAL/E2E
# ==========================================================
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated HTTPS origins allowed to call developer APIs from browsers.
# Never use * when Authorization headers are accepted.
DEVELOPER_CORS_ORIGINS=https://example-client.com
