# ==========================================================
# Credi Marketplace
# Public environment template
#
# Node.js 24.x + Next.js 16.3.x + React 19 + Supabase
#
# This file contains placeholders only. Never add real secrets.
# ==========================================================

# ==========================================================
# SUPABASE - PUBLIC
# ==========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# ==========================================================
# APPLICATION - PUBLIC
# ==========================================================
# Producción canónica. Para desarrollo local puede sobrescribirse en .env.local.
NEXT_PUBLIC_APP_URL=https://credi-marketplace-afiliados.vercel.app
NEXT_PUBLIC_APP_NAME=Credi Marketplace
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_COUNTRY=VE
NEXT_PUBLIC_ENV=development

# ==========================================================
# SUPABASE - SERVER ONLY
# ==========================================================
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ==========================================================
# GOOGLE GEMINI - SERVER ONLY
# ==========================================================
GEMINI_API_KEY=

# ==========================================================
# B2B STABLECOIN PAYMENTS - SERVER ONLY
# ==========================================================
# Enable only after provider onboarding and jurisdiction review.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
B2B_CRYPTO_ENABLED=false
B2B_CRYPTO_MERCHANT_COUNTRY=US

# ==========================================================
# CREDI BUSINESS CHAT - EPHEMERAL TURN (SERVER ONLY)
# ==========================================================
# Twilio Network Traversal Service credentials. Never expose these
# through NEXT_PUBLIC_* variables or ship them to the browser.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ==========================================================
# PLAYWRIGHT - LOCAL/E2E
# ==========================================================
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
