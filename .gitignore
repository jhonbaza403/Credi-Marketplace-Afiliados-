# ============================================================
# Credi Marketplace
# Git ignore
#
# Next.js 16
# React 19
# TypeScript
# Tailwind CSS 4
# Supabase
# Vitest
# Playwright
# Vercel
# Node.js 22.x LTS
# npm 10.x / 11.x
# ============================================================


# ============================================================
# DEPENDENCIAS
# ============================================================

node_modules/
.pnp/
.pnp.js
.pnpm-store/
.yarn/
.yarn-cache/

# npm local configuration
.npmrc.local


# ============================================================
# NEXT.JS
# ============================================================

.next/
out/

# Next.js generated cache
.next/cache/

# Vercel local build/output
.vercel/
.vercel-output/


# ============================================================
# BUILD / DISTRIBUTION
# ============================================================

dist/
build/

# Mantener código fuente y archivos de configuración.
# No ignorar package.json ni package-lock.json.


# ============================================================
# TURBOPACK / SWC / TOOLING CACHE
# ============================================================

.turbo/
.turborepo/
.swc/
.vite/
.cache/
.parcel-cache/


# ============================================================
# TYPESCRIPT
# ============================================================

*.tsbuildinfo


# ============================================================
# ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production

# Plantillas permitidas en Git
!.env.example
!.env.template


# ============================================================
# CREDENCIALES Y SECRETOS
# ============================================================

credentials.json
service-account.json
service-account-key.json

secrets.json
secrets.local.json

*.pem
*.key
*.p12
*.pfx

# Los certificados públicos pueden necesitar versionarse.
# No ignorar *.crt automáticamente si forman parte del proyecto.


# ============================================================
# SUPABASE LOCAL
# ============================================================

supabase/.branches/
supabase/.temp/
supabase/.cache/

# NO ignorar:
#
# supabase/config.toml
# supabase/migrations/
# supabase/functions/
# supabase/tests/
# supabase/seed.sql
#
# Si existe supabase/.gitignore y forma parte del proyecto,
# debe permanecer versionado.


