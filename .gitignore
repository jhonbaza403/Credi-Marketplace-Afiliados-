!supabase/migrations/
!supabase/functions/
!supabase/tests/


# ============================================================
# SECURITY REMINDER
# ============================================================
#
# NUNCA subir:
#
# - SUPABASE_SECRET_KEY
# - SUPABASE_SERVICE_ROLE_KEY
# - GEMINI_API_KEY
# - DATABASE_URL con credenciales
# - tokens
# - contraseñas
# - claves privadas
# - certificados privados
# - secretos de Vercel
#
# Las variables públicas NEXT_PUBLIC_* solo deben contener
# información que realmente pueda exponerse al navegador.
#
# ============================================================
