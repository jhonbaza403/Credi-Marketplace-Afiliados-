# ============================================================
# IMPORTANT — FILES THAT MUST REMAIN VERSIONED
# ============================================================

!package.json
!package-lock.json

!.nvmrc
!next.config.ts
!tsconfig.json
!next-env.d.ts

!eslint.config.mjs
!postcss.config.mjs
