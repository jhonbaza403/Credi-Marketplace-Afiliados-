# ==========================================================

# IMPORTANTE

#

# NO ignorar:

#

# package.json

# package-lock.json

# next.config.ts

# tsconfig.json

# eslint.config.mjs

# postcss.config.mjs

# playwright.config.ts

# vitest.config.ts

# .nvmrc

# .env.example

# supabase/config.toml

# supabase/migrations/

# supabase/tests/

# src/

# public/

#

# Estos archivos pueden ser necesarios para el proyecto,

# el build, las pruebas o las migraciones y no deben quedar

# excluidos accidentalmente por .vercelignore.

# ==========================================================
