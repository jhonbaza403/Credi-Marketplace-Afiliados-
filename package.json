{
  "name": "credi-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Credi Marketplace - plataforma empresarial de comercio, afiliados, B2B, servicios y pagos.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "verify:structure": "node tests/verify-structure.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:all": "npm run check && npm run test:e2e && npm run build",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.453.0",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.53.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0",
    "@tailwindcss/postcss": "4.3.3"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
