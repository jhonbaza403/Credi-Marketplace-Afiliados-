{
  "name": "credi-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Credi Marketplace - plataforma empresarial de comercio, afiliados, B2B, servicios y pagos.",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "verify:structure": "node scripts-verify.mjs",
    "check": "npm run verify:structure && npm run lint && npm run typecheck && npm run test",
    "check:all": "npm run check && npm run test:e2e && npm run build",
    "security:audit": "npm audit --audit-level=critical"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "@hookform/resolvers": "^3.9.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.453.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.53.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  }
}
