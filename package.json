{
  "name": "credi-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Credi Marketplace - plataforma empresarial de comercio, afiliados, B2B, servicios y pagos.",
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:all": "npm run check && npm run test:e2e && npm run build",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "date-fns": "4.4.0",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
